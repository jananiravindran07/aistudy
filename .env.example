# AI Study Assistant — environment variables (local dev)
# Copy to `.env` and fill in real values. Never commit real secrets.

# PostgreSQL connection string (see docker-compose.yml or scripts/db-*.ps1 for local setup)
DATABASE_URL="postgresql://aistudy:aistudy@localhost:5432/aistudy?schema=public"

# Secret used to sign session JWTs — generate with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# OpenAI API key (server-side only — never exposed to the client)
OPENAI_API_KEY=""

# Optional: model to use (defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# Dev convenience: set to "true" to return canned responses when no API key is set
LLM_MOCK="true"