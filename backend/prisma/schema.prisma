datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  carrots       Int       @default(0)
  happiness     Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastSessionAt DateTime?

  conversations Conversation[]
  documents     Document[]
  notes         Note[]
  quizzes       Quiz[]
  studyPlans    StudyPlan[]
  tasks         Task[]
  sessions      StudySession[]
  capybaraState CapybaraState?
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  content        String
  role           String       // "user" or "assistant"
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model StudySession {
  id          String   @id @default(uuid())
  duration    Int
  goal        String?
  completedAt DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Quiz {
  id        String   @id @default(uuid())
  title     String
  questions String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model StudyPlan {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
}

model CapybaraState {
  id          String   @id @default(uuid())
  carrots     Int      @default(0)
  happiness   Int      @default(0)
  level       Int      @default(1)
  streak      Int      @default(0)
  accessories String   @default("[]")
  updatedAt   DateTime @updatedAt
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
}
