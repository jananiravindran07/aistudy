datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MessageRole {
  user
  assistant

  @@map("CapybaraMessageRole")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  carrots       Int       @default(0)
  happiness     Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastSessionAt DateTime?

  conversations Conversation[]
  documents     Document[]
  notes         Note[]
  quizzes       Quiz[]
  studyPlans    StudyPlan[]
  tasks         Task[]
  sessions      StudySession[]
  capybaraState CapybaraState?

  @@map("CapybaraUser")
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  topic     String    @default("General")
  difficulty String   @default("Intermediate")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
  notes     Note[]
  quizzes   Quiz[]
  studyPlans StudyPlan[]

  @@map("CapybaraConversation")
}

model Message {
  id             String       @id @default(uuid())
  content        String
  role           MessageRole
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("CapybaraMessage")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("CapybaraDocument")
}

model StudySession {
  id          String   @id @default(uuid())
  duration    Int
  goal        String?
  completedAt DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@map("CapybaraStudySession")
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("CapybaraNote")
}

model Quiz {
  id        String   @id @default(uuid())
  title     String
  questions Json
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("CapybaraQuiz")
}

model StudyPlan {
  id        String   @id @default(uuid())
  title     String
  content   Json
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("CapybaraStudyPlan")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@map("CapybaraTask")
}

model CapybaraState {
  id          String   @id @default(uuid())
  carrots     Int      @default(0)
  happiness   Int      @default(0)
  level       Int      @default(1)
  streak      Int      @default(0)
  accessories String   @default("[]")
  updatedAt   DateTime @updatedAt
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  @@map("CapybaraPetState")
}
