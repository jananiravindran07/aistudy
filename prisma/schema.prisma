// AI Study Assistant — Prisma schema (Prisma ORM 7)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  assistant
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  conversations Conversation[]
  createdAt     DateTime       @default(now())
}

model Conversation {
  id         String       @id @default(cuid())
  userId     String
  title      String
  topic      String
  difficulty String // "Beginner" | "Intermediate" | "Advanced"
  sourceText String? // extracted text from an uploaded .txt/.pdf (bonus feature)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  notes      Note[]
  quizzes    Quiz[]
  studyPlans StudyPlan[]
  createdAt  DateTime     @default(now())

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           Role
  content        String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Note {
  id             String       @id @default(cuid())
  conversationId String
  content        String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Quiz {
  id             String       @id @default(cuid())
  conversationId String
  questions      Json
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model StudyPlan {
  id             String       @id @default(cuid())
  conversationId String
  content        Json
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}